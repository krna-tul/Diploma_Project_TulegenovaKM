@startuml
left to right direction
actor "Lecturer" as Teacher
actor "Mentor" as Mentor
actor "Mentee" as Mentee
actor "School and director" as School
actor "Vice-rector / registrar" as Rector
actor "Department" as Department
actor "Organiser" as Organizer
Mentor --|> Teacher
Mentee --|> Teacher
rectangle "AITU platform" {
 usecase "Browse skills and events" as Catalog
 usecase "Submit profile / request" as Apply
 usecase "Consent to the pair" as Consent
 usecase "Match and nominate the pair" as Match
 usecase "Register the appointment order" as Appoint
 usecase "Draft and agree the plan" as Plan
 usecase "Approve the plan" as Approve
 usecase "Record a meeting and Development Visit" as Visit
 usecase "Evaluate the outcome / request replacement" as Evaluate
 usecase "Get an aggregated report" as Report
 usecase "Confirm training" as Training
 usecase "Publish an event" as Event
usecase "Check completeness / import XLSX" as Import
usecase "Configure limits / reference lists" as Configure
usecase "Return plan with reason" as ReturnPlan
usecase "Confirm the other participant's meeting" as Confirm
usecase "Produce outcomes / archive" as Archive
}
Teacher --> Catalog
Teacher --> Apply
Mentor --> Consent
Mentee --> Consent
School --> Match
Rector --> Appoint
Mentor --> Plan
Mentee --> Plan
School --> Approve
Mentor --> Visit
Mentee --> Visit
Teacher --> Evaluate
School --> Report
Department --> Training
Organizer --> Event
actor "Academic office" as UMO
actor "Technical administrator" as Admin
UMO --> Import
Admin --> Configure
School --> ReturnPlan
Mentor --> Confirm
Mentee --> Confirm
School --> Archive
@enduml
