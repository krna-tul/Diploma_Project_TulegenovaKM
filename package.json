{
  "name": "aitu-mentorship-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local interaction prototype for the AITU diploma project",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write \"src/prototype/**/*.{js,css,html}\" \"scripts/**/*.mjs\" \"tests/*.mjs\" package.json .prettierrc.json",
    "format:check": "prettier --check \"src/prototype/**/*.{js,css,html}\" \"scripts/**/*.mjs\" \"tests/*.mjs\" package.json .prettierrc.json",
    "check": "npm run format:check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
